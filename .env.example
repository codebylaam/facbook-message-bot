# Postgres (matches compose.yaml)
DATABASE_URL=postgres://fbbot:fbbot@localhost:5432/fbbot

# CommandCode Provider API (OpenAI-compatible)
CMD_API_KEY=
CMD_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_MODEL=deepseek/deepseek-v4-flash

# Embeddings. Cloudflare Workers AI is the default; bge-m3 is 1024 dimensions,
# which matches knowledge_chunks.embedding.
# Leave CF_ACCOUNT_ID and CF_API_TOKEN empty to run keyword-only search.
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_EMBED_MODEL=@cf/baai/bge-m3
# Optional: a self-hosted text-embeddings-inference server, used only when the
# Cloudflare pair above is empty.
EMBED_URL=

# Meta / Facebook Graph API
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Secrets
# 32-byte key, base64 or hex encoded, for AES-256-GCM page token encryption
TOKEN_ENC_KEY=
# Random string used by better-auth to sign sessions (openssl rand -hex 32)
BETTER_AUTH_SECRET=

# Web
WEB_ORIGIN=http://localhost:5173

# API
BETTER_AUTH_URL=http://localhost:3000
