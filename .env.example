# Postgres (matches compose.yaml)
DATABASE_URL=postgres://fbbot:fbbot@localhost:5432/fbbot

# CommandCode Provider API (OpenAI-compatible)
CMD_API_KEY=
CMD_BASE_URL=https://api.commandcode.ai/provider/v1
LLM_MODEL=deepseek/deepseek-v4-flash

# Self-hosted embeddings (text-embeddings-inference, bge-m3)
EMBED_URL=http://localhost:8080

# Meta / Facebook Graph API
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# Secrets
# 32-byte key, base64 or hex encoded, for AES-256-GCM page token encryption
TOKEN_ENC_KEY=
# Random string used by better-auth to sign sessions
BETTER_AUTH_SECRET=

# Web
WEB_ORIGIN=http://localhost:5173
